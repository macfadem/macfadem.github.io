---
import Base from '../layouts/Base.astro';
import Pulse from './Pulse.astro';
import type { Dict } from '../i18n/pt';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const P = t.projects;
const L = P.labels;
const GITHUB = 'https://github.com/macfadem';
const LINKEDIN = 'https://www.linkedin.com/in/macfadem/';
const EMAIL = 'k_macfadem@hotmail.com';
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base t={t}>
  <div class="rail" aria-hidden="true"><span></span><i></i></div>

  <header class="top wrap">
    <a class="brand" href={t.path}>kevin macfadem</a>
    <nav aria-label={t.nav.main}>
      <a href="#projetos">{t.nav.projects}</a>
      <a href="#experiencia">{t.nav.experience}</a>
      <a href="#sobre">{t.nav.about}</a>
      <a href="#contato">{t.nav.contact}</a>
    </nav>
    <a class="lang" href={t.otherPath} hreflang={t.otherLabel.toLowerCase()} aria-label={t.otherAria}>{t.otherLabel}</a>
  </header>

  <main id="conteudo">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1><span>{t.hero.title[0]}</span> <span>{t.hero.title[1]}</span></h1>
        <div class="hero-row">
          <p class="lead">{t.hero.lead}</p>
          <div class="cta">
            <a class="btn solid" href="#projetos">{t.hero.cta}</a>
            <a class="btn" href={t.cv}>{t.hero.cta2}</a>
          </div>
        </div>
      </div>

      <svg class="line wide" viewBox="0 0 1440 260" aria-hidden="true">
        <path
          class="trace"
          pathLength="1"
          d="M0,150 L110,150 Q122,134 134,150 L150,150 L156,162 L168,60 L180,182 L188,150 L208,150 Q226,122 244,150 L290,150 Q302,134 314,150 L330,150 L336,162 L348,60 L360,182 L368,150 L388,150 Q406,122 424,150 L500,150 L500,122 L640,122 L640,94 L780,94 L780,66 L900,66 L910,76 L920,20 L932,96 L940,66 L980,66 C1100,60 1260,40 1420,22"
        ></path>
        <path
          class="spark"
          pathLength="1"
          d="M0,150 L110,150 Q122,134 134,150 L150,150 L156,162 L168,60 L180,182 L188,150 L208,150 Q226,122 244,150 L290,150 Q302,134 314,150 L330,150 L336,162 L348,60 L360,182 L368,150 L388,150 Q406,122 424,150 L500,150 L500,122 L640,122 L640,94 L780,94 L780,66 L900,66 L910,76 L920,20 L932,96 L940,66 L980,66 C1100,60 1260,40 1420,22"
        ></path>
        <g>
          <circle cx="570" cy="122" r="9"></circle>
          <circle cx="710" cy="94" r="9"></circle>
          <circle cx="840" cy="66" r="9"></circle>
        </g>
        <circle class="end" cx="1420" cy="22" r="9"></circle>
      </svg>
      <svg class="line narrow" viewBox="0 0 390 150" aria-hidden="true">
        <path
          class="trace"
          pathLength="1"
          d="M0,86 L30,86 Q36,78 42,86 L50,86 L53,92 L60,34 L67,104 L71,86 L82,86 Q91,72 100,86 L130,86 L130,70 L190,70 L190,54 L250,54 L250,38 L300,38 L303,44 L309,14 L315,52 L319,38 L330,38 C350,34 370,28 384,22"
        ></path>
        <path
          class="spark"
          pathLength="1"
          d="M0,86 L30,86 Q36,78 42,86 L50,86 L53,92 L60,34 L67,104 L71,86 L82,86 Q91,72 100,86 L130,86 L130,70 L190,70 L190,54 L250,54 L250,38 L300,38 L303,44 L309,14 L315,52 L319,38 L330,38 C350,34 370,28 384,22"
        ></path>
        <g>
          <circle cx="160" cy="70" r="6"></circle>
          <circle cx="220" cy="54" r="6"></circle>
        </g>
        <circle class="end" cx="384" cy="22" r="6"></circle>
      </svg>

      <ol class="stops wrap">
        {
          t.hero.stops.map((s) => (
            <li>
              <a href={s.href}>
                <span class="k">{s.k}</span>
                <strong>{s.t}</strong>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="projetos" class="section wrap">
      <p class="kicker">{P.kicker}</p>
      <h2>{P.title}</h2>

      <div class="projects">
        {
          P.main.map((p, i) => (
            <article class={`project w-${p.widget}`} id={p.id}>
              <header class="project-head">
                <p class="tag">
                  <span class="num">{L.project} {pad(i + 1)}</span> · {p.kind}
                </p>
                <h3>{p.name}</h3>
                <p class="sub">{p.sub}</p>
              </header>

              {p.embed ? (
                <div class="media embed" data-embed>
                  <div class="embed-bar">
                    <div class="seg" role="tablist" aria-label={p.name}>
                      {p.embed.frames.map((f, k) => (
                        <button type="button" role="tab" id={`${p.id}-frame-tab-${k}`} aria-controls={`${p.id}-frame-${k}`} aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1} data-url={f.url} data-prompt={f.prompt}>
                          {f.label}
                        </button>
                      ))}
                    </div>
                    <a class="embed-open" href={p.embed.frames[0].url} target="_blank" rel="noopener" data-open>
                      {p.embed.open} ↗
                    </a>
                  </div>
                  <div class="embed-stage" data-stage>
                    {p.embed.frames.map((f, k) => (
                      <div class="embed-frame" id={`${p.id}-frame-${k}`} role="tabpanel" aria-labelledby={`${p.id}-frame-tab-${k}`} hidden={k !== 0}>
                        <img class="poster" src={f.poster} alt="" loading="lazy" decoding="async" />
                        <iframe data-src={f.url} title={f.title} allow="autoplay; fullscreen; clipboard-write" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1"></iframe>
                      </div>
                    ))}
                    <button type="button" class="embed-cover" data-cover>
                      <span>{p.embed.frames[0].prompt}</span>
                    </button>
                  </div>
                  <p class="embed-note"><strong data-task hidden>{p.embed.frames[1].prompt}. </strong>{p.embed.note}</p>
                </div>
              ) : (
              <figure class="media">
                {p.media.video ? (
                  <video src={p.media.video} poster={p.media.image} muted loop playsinline preload="none" data-autoplay aria-label={p.media.alt} />
                ) : (
                  <img src={p.media.image} alt={p.media.alt} loading="lazy" decoding="async" />
                )}
                <figcaption>{p.media.caption}</figcaption>
              </figure>
              )}

              <div class="widget">
                <p class="tag">{p.widget === 'xray' ? L.result : L.tryIt}</p>
                {(p.widget === 'asc' || p.widget === 'moo') && (
                  <div data-steps>
                    <h4>{P[p.widget].title}</h4>
                    <div class="steps" role="tablist" aria-label={P[p.widget].title}>
                      {P[p.widget].steps.map((s, k) => (
                        <button type="button" role="tab" id={`${p.widget}-tab-${k}`} aria-controls={`${p.widget}-panel`} aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1} data-text={s.t}>
                          <span class="dot" />
                          {s.k}
                        </button>
                      ))}
                    </div>
                    <p class="step-text" id={`${p.widget}-panel`} role="tabpanel" aria-labelledby={`${p.widget}-tab-0`} aria-live="polite">{P[p.widget].steps[0].t}</p>
                    {p.widget === 'asc' && (
                      <div class="vote-record">
                        <h4>{P.asc.record.title}</h4>
                        <p><time datetime="2026-06-17">{P.asc.record.date}</time> · {P.asc.record.subject}</p>
                        <p><strong>{P.asc.record.tally}</strong></p>
                        <a href="https://dadosabertos.camara.leg.br/api/v2/votacoes/2382675-97">{P.asc.record.source} ↗</a>
                      </div>
                    )}
                  </div>
                )}
                {p.widget === 'xray' && (
                  <div class="xray">
                    <div class="xray-metric">
                      <span class="big">{P.xray.metric}</span>
                      <span class="small">{P.xray.metricLabel}</span>
                    </div>
                    <p class="small">{P.xray.classesLabel}</p>
                    <ul class="chips">
                      {P.xray.classes.map((c) => <li>{c}</li>)}
                    </ul>
                    <p>{P.xray.split}</p>
                    <p class="evaluation-note">{P.xray.errors}</p>
                  </div>
                )}
                {p.widget === 'cofrinho' && (
                  <div data-cofrinho data-items={JSON.stringify(P.cofrinho.items)} data-week={P.cofrinho.week} data-lang={t.lang}>
                    <h4>{P.cofrinho.title}</h4>
                    <ul class="fila" data-fila>
                      {P.cofrinho.items.map((it) => (
                        <li>
                          <div class="fila-row">
                            <span>{it.name}</span>
                            <span class="mono" data-when />
                          </div>
                          <div class="fila-bar">
                            <span data-bar />
                          </div>
                        </li>
                      ))}
                    </ul>
                    <div class="aporte">
                      <label for="aporte">
                        {P.cofrinho.label}: <strong data-aporte />
                      </label>
                      <input id="aporte" type="range" min="20" max="300" step="10" value="100" />
                      <p class="note">{P.cofrinho.note}</p>
                    </div>
                  </div>
                )}
              </div>

              {p.features && (
                <div class="features">
                  <p class="tag">{L.features}</p>
                  <ul>
                    {p.features.map((f) => <li>{f}</li>)}
                  </ul>
                </div>
              )}

              <details class="how">
                <summary>{L.details}</summary>
                <dl>
                  <div>
                    <dt>{L.problem}</dt>
                    <dd>{p.problem}</dd>
                  </div>
                  <div>
                    <dt>{L.decisions}</dt>
                    <dd>
                      <ul>
                        {p.decisions.map((d) => <li>{d}</li>)}
                      </ul>
                    </dd>
                  </div>
                  <div>
                    <dt>{L.stack}</dt>
                    <dd class="mono">{p.stack}</dd>
                  </div>
                  <div>
                    <dt>{L.status}</dt>
                    <dd>{p.status}</dd>
                  </div>
                </dl>
              </details>
              {p.links.map((l) => (
                <a class="tile-link" href={l.href}>{l.label} ↗</a>
              ))}
            </article>
          ))
        }
      </div>

      <h3 class="more">{L.more}</h3>
      <div class="small-grid">
        {
          P.small.map((p, i) => (
            <article class="card">
              <div class={`card-media${p.name === 'Reactify' ? ' contain' : ''}`}>
                {p.video ? (
                  <video src={p.video} poster={p.image} muted loop playsinline preload="none" data-autoplay aria-label={p.alt} />
                ) : (
                  <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
                )}
              </div>
              <p class="tag">
                <span class="num">{L.project} {pad(i + 1 + P.main.length)}</span> · {p.kind}
              </p>
              {p.award && <p class="award">{p.award}</p>}
              <h4>{p.name}</h4>
              <p>{p.body}</p>
              <a class="tile-link" href={p.link.href} rel="noopener">{p.link.label} ↗</a>
            </article>
          ))
        }
      </div>
    </section>

    <section id="experiencia" class="section wrap">
      <Pulse />
      <p class="kicker">{t.experience.kicker}</p>
      <h2>{t.experience.title}</h2>
      <ol class="timeline">
        {
          t.experience.items.map((e) => (
            <li>
              <span class="when mono">{e.when}</span>
              <div>
                <h3>{e.role}</h3>
                <p class="org">{e.org}</p>
                {e.body && <p>{e.body}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="sobre" class="section wrap about">
      <Pulse />
      <div>
        <p class="kicker">{t.about.kicker}</p>
        <h2>{t.about.title}</h2>
        {t.about.body.map((p) => <p class="prose">{p}</p>)}
      </div>
      <dl class="facts">
        {
          t.about.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>

  <footer id="contato" class="contact">
    <div class="wrap">
      <Pulse dark />
      <p class="kicker">{t.contact.kicker}</p>
      <h2>{t.contact.title}</h2>
      <p class="prose">{t.contact.body}</p>
      <div class="cta">
        <a class="btn solid inv" href={`mailto:${EMAIL}`}>{t.contact.email}</a>
        <a class="btn inv" href={t.cv}>{t.contact.cv}</a>
        <a class="btn inv" href={LINKEDIN}>LinkedIn</a>
        <a class="btn inv" href={GITHUB}>GitHub</a>
      </div>
      <p class="foot mono">
        © 2026 Kevin Macfadem · <a href={`${GITHUB}/macfadem.github.io`}>{t.footer}</a>
      </p>
    </div>
  </footer>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Trilho lateral e linhas de batimento: acompanham a rolagem.
    const rail = document.querySelector<HTMLElement>('.rail span');
    const railEl = document.querySelector<HTMLElement>('.rail');
    const scrub = [...document.querySelectorAll<SVGElement>('[data-scrub]')];
    const clamp = (n: number) => Math.min(1, Math.max(0, n));
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? clamp(window.scrollY / max) : 0;
        if (rail) rail.style.transform = `scaleY(${p})`;
        railEl?.style.setProperty('--p', String(p));
        const vh = window.innerHeight;
        scrub.forEach((el) => {
          const r = el.getBoundingClientRect();
          // começa a desenhar quando entra na tela e fecha antes do fim da página
          const d = reduce ? 0 : 1 - clamp((vh * 0.98 - r.top) / (vh * 0.34));
          el.style.setProperty('--d', String(d));
        });
        ticking = false;
      });
    };
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Cofrinho: a fila enche na ordem; cada item sai na semana em que o saldo alcança a soma até ele.
    document.querySelectorAll<HTMLElement>('[data-cofrinho]').forEach((el) => {
      const items: { name: string; price: number }[] = JSON.parse(el.dataset.items ?? '[]');
      const week = el.dataset.week ?? '';
      const money = new Intl.NumberFormat(el.dataset.lang, { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
      const input = el.querySelector<HTMLInputElement>('input[type=range]');
      const out = el.querySelector<HTMLElement>('[data-aporte]');
      const rows = [...el.querySelectorAll<HTMLElement>('[data-fila] li')];
      const render = () => {
        if (!input) return;
        const aporte = Number(input.value);
        if (out) out.textContent = money.format(aporte);
        let sum = 0;
        const weeks = items.map((it) => Math.ceil((sum += it.price) / aporte));
        const last = weeks[weeks.length - 1] || 1;
        rows.forEach((row, i) => {
          const when = row.querySelector<HTMLElement>('[data-when]');
          const bar = row.querySelector<HTMLElement>('[data-bar]');
          if (when) when.textContent = `${money.format(items[i].price)} · ${week} ${weeks[i]}`;
          if (bar) bar.style.width = `${Math.max(6, (weeks[i] / last) * 100)}%`;
        });
      };
      input?.addEventListener('input', render);
      render();
    });

    // Etapas (pipeline e painel): abas com setas do teclado.
    document.querySelectorAll<HTMLElement>('[data-steps]').forEach((el) => {
      const tabs = [...el.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const panel = el.querySelector<HTMLElement>('[role=tabpanel]');
      const select = (i: number, focus = false) => {
        tabs.forEach((tab, k) => {
          tab.setAttribute('aria-selected', String(k === i));
          tab.tabIndex = k === i ? 0 : -1;
        });
        if (panel) {
          panel.textContent = tabs[i].dataset.text ?? '';
          panel.setAttribute('aria-labelledby', tabs[i].id);
        }
        if (focus) tabs[i].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
          if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        });
      });
    });

    // Site ao vivo: carrega perto da tela, mostra a área de trabalho em escala e só captura o mouse depois de um clique.
    document.querySelectorAll<HTMLElement>('[data-embed]').forEach((el) => {
      const stage = el.querySelector<HTMLElement>('[data-stage]');
      const tabs = [...el.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const frames = [...el.querySelectorAll<HTMLElement>('.embed-frame')];
      const cover = el.querySelector<HTMLButtonElement>('[data-cover]');
      const open = el.querySelector<HTMLAnchorElement>('[data-open]');
      const task = el.querySelector<HTMLElement>('[data-task]');
      const coverLabel = cover?.querySelector('span');
      if (!stage) return;
      const W = 1280;
      const H = 800;
      let current = 0;
      let near = false;

      const load = (i: number) => {
        const iframe = frames[i]?.querySelector<HTMLIFrameElement>('iframe');
        if (!iframe || iframe.src) return;
        iframe.addEventListener('load', () => frames[i].classList.add('loaded'), { once: true });
        iframe.src = iframe.dataset.src ?? '';
      };

      const fit = () => {
        const w = stage.clientWidth;
        const desk = w >= 720;
        stage.classList.toggle('scaled', desk);
        stage.style.setProperty('--s', String(w / W));
        stage.style.setProperty('--w', `${W}px`);
        stage.style.setProperty('--h', `${H}px`);
      };
      new ResizeObserver(fit).observe(stage);
      fit();

      const activate = () => {
        el.classList.add('live');
        if (task) task.hidden = current !== 1;
        frames[current].querySelector('iframe')?.setAttribute('tabindex', '0');
        load(current);
      };
      cover?.addEventListener('click', activate);

      const select = (i: number, focus = false) => {
        current = i;
        tabs.forEach((tab, k) => {
          tab.setAttribute('aria-selected', String(k === i));
          tab.tabIndex = k === i ? 0 : -1;
        });
        frames.forEach((f, k) => (f.hidden = k !== i));
        if (open) open.href = tabs[i].dataset.url ?? open.href;
        if (coverLabel) coverLabel.textContent = tabs[i].dataset.prompt ?? '';
        if (task) task.hidden = i !== 1 || !el.classList.contains('live');
        if (near || el.classList.contains('live')) load(i);
        frames[i].querySelector('iframe')?.setAttribute('tabindex', el.classList.contains('live') ? '0' : '-1');
        if (focus) tabs[i].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
          if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        });
      });

      new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((en) => en.isIntersecting)) {
            near = true;
            load(current);
            obs.disconnect();
          }
        },
        { rootMargin: '400px 0px' },
      ).observe(stage);
    });

    // Vídeo: só toca quando aparece na tela, e nunca com "reduzir movimento".
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
      if (reduce) {
        v.controls = true;
        return;
      }
      new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) v.play().catch(() => (v.controls = true));
            else v.pause();
          });
        },
        { threshold: 0.35 },
      ).observe(v);
    });
  </script>
</Base>
