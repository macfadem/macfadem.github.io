  </svg>
  <svg class="narrow" viewBox="0 0 390 56" data-scrub>
    <path
      pathLength="1"
      d="M0,34 L60,34 Q68,26 76,34 L88,34 L93,42 L101,8 L109,50 L115,34 L130,34 Q142,20 154,34 L220,34 L225,42 L233,8 L241,50 L247,34 L280,34 C320,34 355,24 390,14"
